rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Chat attachments: a visitor writes into their own thread folder; the
    // reader (admin) can read and write every thread. Put the same admin
    // emails here as in firestore.rules.
    // email_verified matters: Firebase issues a token carrying whatever address
    // was typed at sign-up, verified or not, so without this check anyone could
    // sign up as the owner's address and read every attachment. See
    // firestore.rules for the same reasoning.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['nabutarot@outlook.com', 'angela_le_@outlook.com', 'angelale_le_@outlook.com'];
    }
    match /threads/{uid}/{file} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == uid || isAdmin()) && request.resource.size < 8 * 1024 * 1024;
    }
    // Nothing else in the bucket is reachable from the app.
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
