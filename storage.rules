rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Chat attachments: a visitor writes into their own thread folder; the
    // reader (admin) can read and write every thread. Put the same admin
    // emails here as in firestore.rules.
    // email_verified matters: Firebase issues a token with whatever address
    // was typed at sign-up, verified or not. See firestore.rules.
    function isAdmin() { return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email in ['nabutarot@outlook.com', 'angela_le_@outlook.com', 'angelale_le_@outlook.com']; }
    match /threads/{uid}/{file} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == uid || isAdmin()) && request.resource.size < 8 * 1024 * 1024;
    }
  }
}
