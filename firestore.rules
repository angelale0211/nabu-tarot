rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Put the reader's login emails here (same list as CONFIG.adminEmails).
    function isAdmin() {
      return request.auth != null && request.auth.token.email in ['nabutarot@outlook.com', 'angela_le_@outlook.com', 'angelale_le_@outlook.com'];
    }
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }

    match /users/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }
    match /threads/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) || isAdmin();
      match /messages/{mid} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if (isOwner(uid) && request.resource.data.from == 'user')
                      || (isAdmin() && request.resource.data.from == 'nabu');
        // Account deletion inside the app removes the person's own messages.
        allow delete: if isOwner(uid) || isAdmin();
      }
    }
    match /bookings/{id} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
      // Nabu manages bookings; a person may remove their own when deleting the account.
      allow delete: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
    }
    // Posts and availability edited in the dashboard: everyone reads, Nabu writes.
    match /content/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /reports/{id} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }
    // Taken slots are public so the calendar can hide them; only signed-in
    // users can claim one, and only if it is still free.
    match /taken/{slot} {
      allow read: if true;
      allow create: if request.auth != null && !exists(/databases/$(database)/documents/taken/$(slot));
      allow update, delete: if isAdmin();
    }
  }
}
