rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /* Who counts as Nabu.

       email_verified matters here and is not decoration. Firebase hands out a
       token with whatever address was typed into "create an account with email
       and password", verified or not. Without this check, anyone could sign up
       as nabutarot@outlook.com and read every booking, every private message,
       and rewrite every price in the app. Outlook will not let them verify an
       address they do not own, so the check closes it.

       Sturdier still would be a list of uids, which cannot be claimed at all.
       Add them here once they are known and drop the email list. */
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['nabutarot@outlook.com', 'angela_le_@outlook.com', 'angelale_le_@outlook.com'];
    }
    // The one of a pair that is not me, used to find the invitation they sent.
    function otherIn(uids) { return uids[0] == request.auth.uid ? uids[1] : uids[0]; }
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    function shorterThan(field, n) {
      return !(field in request.resource.data) || !(request.resource.data[field] is string) || request.resource.data[field].size() < n;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }
    match /threads/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) || isAdmin();
      match /messages/{mid} {
        allow read: if isOwner(uid) || isAdmin();
        // A message is a message, not a place to park a megabyte.
        allow create: if ((isOwner(uid) && request.resource.data.from == 'user')
                      || (isAdmin() && request.resource.data.from == 'nabu'))
                      && shorterThan('text', 4000);
        // Account deletion inside the app removes the person's own messages.
        allow delete: if isOwner(uid) || isAdmin();
      }
    }
    match /bookings/{id} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
                    && shorterThan('note', 2000) && shorterThan('message', 8000)
                    && shorterThan('service', 500) && shorterThan('name', 200)
                    && shorterThan('where', 20) && shorterThan('whereName', 60);
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      /* Nabu manages bookings. The person who made one may ask to move or
         cancel it, which touches those three fields and nothing else - not the
         price, not the slot itself, not whose booking it is. */
      allow update: if isAdmin()
                    || (request.auth != null && resource.data.uid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'newSlot', 'prevStatus'])
                        && request.resource.data.status in ['change_requested', 'cancel_requested']);
      allow delete: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
    }
    /* Posts, availability, activities and the sale are edited in the dashboard:
       everyone reads them, Nabu writes them.

       content/ai is the exception. It holds an API key, and a rule that lets
       the whole internet read it is the same as publishing the key. Only Nabu
       reads that one; the app answers from its built-in text when it cannot. */
    match /content/{doc} {
      allow read: if doc != 'ai' || isAdmin();
      allow write: if isAdmin();
    }
    // Activity votes and pile choices: readable by all (results are counted on the phone), written only by their owner.
    match /votes/{id} {
      allow read: if true;
      allow create, update: if request.auth != null && request.resource.data.uid == request.auth.uid
                            && id == request.resource.data.aid + '_' + request.auth.uid
                            && shorterThan('aid', 120);
      allow delete: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
    }
    /* ---- the red thread ----
       A handle points at one account and is claimed by that account alone.
       Readable one at a time by anyone signed in, because that is how you find
       the person who gave you their handle; not listable, so the app never
       becomes a directory of everyone who uses it. */
    match /handles/{handle} {
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    /* The public card: a chosen name and a handle, nothing else. Same reading
       rule, and only its owner writes it. */
    match /people/{uid} {
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow write: if isOwner(uid) && shorterThan('name', 40) && shorterThan('handle', 30);
    }
    /* An invitation lives under the person invited, so only they can read what
       has been sent to them. The sender may withdraw it, the receiver may
       refuse it, and either way it is the same delete. */
    match /requests/{to}/from/{from} {
      allow read: if isOwner(to);
      allow create: if isOwner(from) && request.resource.data.uid == request.auth.uid
                    && shorterThan('note', 300) && shorterThan('name', 40) && shorterThan('handle', 30);
      allow delete: if isOwner(to) || isOwner(from);
    }
    /* An invitation link. The token in the path is the whole secret: sixteen
       random characters, handed by the person who made it to the one person
       they meant it for. So anyone signed in may read one they hold the token
       for, and may clear it once it has been used - but they cannot be listed,
       so there is no way to collect them. */
    match /invites/{token} {
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid
                    && shorterThan('name', 40) && shorterThan('handle', 30);
      allow delete: if request.auth != null;
    }
    /* A bond is two people who both agreed, and the agreement is checked here
       rather than trusted from the phone: creating one requires that the other
       person's invitation to me actually exists. Its id is the two account ids
       in order, so a pair can hold only one.

       It is readable by anyone signed in on purpose - being shown as a couple
       is the whole point of it - and it carries only two display names, two
       handles and a date.

       Either person can delete it, alone, at any time. That is deliberate: no
       app should be able to hold someone in a relationship. */
    match /bonds/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uids is list
                    && request.resource.data.uids.size() == 2
                    && request.auth.uid in request.resource.data.uids
                    && id == request.resource.data.uids[0] + '__' + request.resource.data.uids[1]
                    && request.resource.data.uids[0] < request.resource.data.uids[1]
                    && (
                         // they invited me inside the app...
                         exists(/databases/$(database)/documents/requests/$(request.auth.uid)/from/$(otherIn(request.resource.data.uids)))
                         // ...or they made the link I opened, which says who made it
                         || (request.resource.data.invite is string
                             && exists(/databases/$(database)/documents/invites/$(request.resource.data.invite))
                             && get(/databases/$(database)/documents/invites/$(request.resource.data.invite)).data.from == otherIn(request.resource.data.uids))
                       )
                    && shorterThan('invite', 60)
                    && shorterThan('aName', 40) && shorterThan('bName', 40)
                    && shorterThan('aHandle', 30) && shorterThan('bHandle', 30);
      /* What either of them may change: the day it began, the question on it,
         the stage, and the word each has chosen for themselves.

         Two guards make the question mean something.

         An ask may only ever name the person writing it. Without that, either
         of them could write "you asked me" onto the bond and agree with
         themselves a moment later.

         The stage only moves on when the stored ask names the other one - and
         because of the guard above, that ask can only have been put there by
         them. So consent is consent. Everything else about the stage is left
         where it is. */
      allow update: if request.auth != null && request.auth.uid in resource.data.uids
                    && request.resource.data.uids == resource.data.uids
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['since', 'state', 'ask', 'engagedOn', 'marriedOn', 'day', 'aRole', 'bRole'])
                    && (!('ask' in request.resource.data)
                        || request.resource.data.ask == null
                        || request.resource.data.ask.by == request.auth.uid)
                    && (request.resource.data.state == resource.data.state
                        || (('ask' in resource.data) && resource.data.ask != null
                            && resource.data.ask.by == otherIn(resource.data.uids)
                            && request.resource.data.state == 'engaged' && resource.data.state == 'tied')
                        || (request.resource.data.state == 'married' && resource.data.state == 'engaged'))
                    // each of them names only themselves
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['aRole'])
                        || request.auth.uid == resource.data.a)
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['bRole'])
                        || request.auth.uid == resource.data.b);
      allow delete: if request.auth != null && request.auth.uid in resource.data.uids;

      /* What one gives the other. Only the two of them can see them or add to
         them, and a gift is signed with the id of whoever gave it. Either may
         clear one; nobody can rewrite one after the fact. */
      match /gifts/{gid} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/bonds/$(id)).data.uids;
        allow create: if request.auth != null
                    && request.resource.data.from == request.auth.uid
                    && request.auth.uid in get(/databases/$(database)/documents/bonds/$(id)).data.uids
                    && shorterThan('note', 300) && shorterThan('kind', 40);
        allow delete: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/bonds/$(id)).data.uids;
      }
    }
    match /reports/{id} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
                    && shorterThan('what', 4000) && shorterThan('info', 4000);
      allow read, update, delete: if isAdmin();
    }
    /* Taken slots are public so the calendar can hide them. A slot may only be
       claimed for a booking that already exists and belongs to the person
       claiming it, so the calendar cannot be emptied by someone signing in and
       claiming every hour of the month. */
    match /taken/{slot} {
      allow read: if true;
      allow create: if request.auth != null
                    && !exists(/databases/$(database)/documents/taken/$(slot))
                    && request.resource.data.bookingId is string
                    && (isAdmin()
                        || get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.uid == request.auth.uid);
      allow update: if isAdmin()
                    || (request.auth != null
                        && request.resource.data.bookingId is string
                        && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }
  }
}
